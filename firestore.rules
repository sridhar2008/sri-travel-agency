rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.admin == true
          || request.auth.token.email == 'sridhar.govindan2008@gmail.com');
    }

    match /users/{userId} {
      allow create, read, update: if request.auth != null && request.auth.uid == userId;
    }

    match /submissions/{submissionId} {
      allow create: if request.resource.data.keys().hasOnly([
          'type', 'email', 'createdAt', 'name', 'phone', 'state', 'destination', 'packageId', 'travelers', 'stayDays', 'hotelPlan', 'transport', 'estimatedPrice', 'suggestion', 'tripPlan'
        ])
        && request.resource.data.type in ['contact', 'newsletter']
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.createdAt == request.time
        && (request.resource.data.type == 'newsletter'
          || (request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 120
            && request.resource.data.state is string
            && request.resource.data.state.size() > 0
            && request.resource.data.state.size() <= 80
            && request.resource.data.destination is string
            && request.resource.data.destination.size() > 0
            && request.resource.data.destination.size() <= 80
            && request.resource.data.packageId is string
            && request.resource.data.packageId.size() > 0
            && request.resource.data.travelers is int
            && request.resource.data.travelers >= 1
            && request.resource.data.travelers <= 20
            && request.resource.data.stayDays is int
            && request.resource.data.stayDays >= 1
            && request.resource.data.stayDays <= 30
            && request.resource.data.hotelPlan in ['budget', 'standard', 'premium']
            && request.resource.data.transport is string
            && request.resource.data.transport.size() > 0
            && request.resource.data.estimatedPrice is string
            && request.resource.data.suggestion is string
            && request.resource.data.suggestion.size() > 0
            && request.resource.data.suggestion.size() <= 2000
            && request.resource.data.tripPlan is map));
      allow read, update, delete: if isAdmin();
    }
  }
}
